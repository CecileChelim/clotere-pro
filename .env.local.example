# Copier ce fichier en .env.local et renseigner les valeurs depuis
# Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publique du site, utilisée pour construire le lien de réservation
# affiché dans l'espace CGP (app/(dashboard)/dashboard/diffusion).
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # dev local uniquement : en prod, les liens suivent le métier (avocat./comptable.)

# E-mails — Google Workspace (SMTP Gmail), voir lib/envoi-mail.ts
GMAIL_USER=cecile@clotere.fr
GMAIL_PASS=xxxx xxxx xxxx xxxx               # mot de passe d'application Google (16 caractères)
# EMAIL_FROM=contact@clotere.fr              (par défaut ; doit être un alias « Envoyer en tant que » de GMAIL_USER)
# MAIL_PROVIDER=brevo + BREVO_API_KEY=…      (uniquement pour revenir à Brevo)
# ADMIN_EMAIL=contact@clotere.fr              (alertes internes et réponses des pros)
