# Copier ce fichier en .env.local et renseigner les valeurs depuis
# Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publique du site, utilisée pour construire le lien de réservation
# affiché dans l'espace CGP (app/(dashboard)/dashboard/diffusion).
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # dev local uniquement : en prod, les liens suivent le métier (avocat./comptable.)

# E-mails (Brevo) — expéditeurs par métier, domaine clotere.fr authentifié
BREVO_API_KEY=xkeysib-...
# EMAIL_FROM_AVOCAT=avocat@clotere.fr        (par défaut)
# EMAIL_FROM_COMPTABLE=comptable@clotere.fr  (par défaut)
# ADMIN_EMAIL=contact@clotere.fr              (alertes internes et réponses des pros)
